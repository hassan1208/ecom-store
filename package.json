{
  "name": "builtco-sports",
  "private": true,
  "description": "Build tooling for the BuiltCo Sports storefront (compiles Tailwind CSS, copies vendor libraries).",
  "scripts": {
    "build": "npm run build:css && npm run build:admin-css && npm run vendor",
    "build:css": "tailwindcss -c tailwind.config.js -i assets/src/site.css -o assets/css/site.css --minify",
    "build:admin-css": "tailwindcss -c tailwind.admin.config.js -i assets/src/admin.css -o admin/assets/css/admin.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i assets/src/site.css -o assets/css/site.css --watch",
    "vendor": "node tools/copy-vendor.js"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.5.1",
    "@tailwindcss/typography": "^0.5.15",
    "quill": "^1.3.7",
    "tailwindcss": "^3.4.17",
    "three": "0.158.0"
  }
}
